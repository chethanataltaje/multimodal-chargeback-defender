# Cloud VLM Providers (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Secondary Fallback Provider (Groq Vision)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional Official Razorpay Python SDK Credentials
# Leave empty to run in truthful "DEMO SIMULATION — NOT SENT TO RAZORPAY" mode.
# Set rzp_test_* keys to run in "RAZORPAY CE 3.0 • TEST API" mode.
# Set rzp_live_* keys to run in "RAZORPAY CE 3.0 • LIVE API" mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
